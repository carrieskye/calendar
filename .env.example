# Copy to `.env` (gitignored). Pipenv loads `.env` for every command.

# Always use this project’s Pipenv venv — not whatever venv is active in your shell.
# Fixes: wrong .project path, calendar-*-python vs calendar-* mismatch, nested venv confusion.
PIPENV_IGNORE_VIRTUALENVS=1

# Optional: pin interpreter. Must be the actual binary (see `which python3.12`).
# Do NOT set to .../bin/python alone — Pipenv can mangle it with python_version (you may see python33.12.0).
# PIPENV_PYTHON=/full/path/to/python3.12
